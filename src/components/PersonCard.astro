---
export interface Person {
  name: string;
  imageSrc: string;
  position: string;
  bio?: string;
}

const { name, imageSrc, position, bio } = Astro.props as Person;
---

<div class="group relative overflow-hidden rounded-3xl border border-white/10 bg-secondary text-white shadow-lg shadow-black/20 transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl">
  <img
    src={imageSrc}
    alt={`Portrait of ${name}`}
    class="h-80 w-full object-cover transition duration-500 group-hover:scale-105"
  />

  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-black/0 opacity-90 transition-opacity duration-300 group-hover:opacity-100"></div>

  <div class="relative flex h-full flex-col justify-end p-5 text-center">
    <div class="rounded-3xl bg-black/50 p-4 backdrop-blur-md transition-transform duration-300 group-hover:-translate-y-2">
      <h1 class="text-xl font-semibold tracking-tight">{name}</h1>
      <h2 class="mt-1 text-sm uppercase tracking-[0.25em] text-orange-300">{position}</h2>
      {bio ? (
        <p class="mt-3 text-sm leading-6 text-slate-200 opacity-90 line-clamp-4">
          {bio}
        </p>
      ) : (
        <p class="mt-3 text-sm leading-6 text-slate-200 opacity-90">
          Teammitglied der Band mit Leidenschaft für Musik und Auftritte.
        </p>
      )}
    </div>
  </div>
</div>

<style>
  .line-clamp-4 {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>